{
  "name": "code-review-tour",
  "version": "0.3.0",
  "private": true,
  "description": "A local, agent-led walkthrough for Git changes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcosteira79/code-review-tour.git"
  },
  "type": "module",
  "bin": {
    "code-review-tour": "src/cli.ts",
    "code-review-tour-bridge": "src/bridge-client.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "bridge": "bun run src/bridge-client.ts",
    "build:release": "bash scripts/build-release.sh",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bun run typecheck && bun test && node --check public/theme.js && node --check public/app.js"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
