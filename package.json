{
  "name": "diffcompass",
  "version": "2.1.2",
  "private": true,
  "description": "A local, agent-led walkthrough for Git changes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mindera/diffcompass.git"
  },
  "type": "module",
  "bin": {
    "diffcompass": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "bridge": "bun run src/cli.ts bridge",
    "fixture": "bun run scripts/test-fixture.ts",
    "fixture:github-suggestions": "bun scripts/github-suggestions-fixture.ts",
    "build:release": "bash scripts/build-release.sh",
    "test": "bun test",
    "test:monaco": "bun scripts/check-monaco.ts",
    "test:github-suggestions-browser": "bun scripts/check-github-suggestions.ts",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bun run typecheck && bun test && node --check public/theme.js && node --check public/app.js && node --check public/diagram-labels.js"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@dagrejs/dagre": "1.1.8",
    "mermaid": "^11.16.1",
    "monaco-editor": "0.55.1",
    "shiki": "^4.4.2",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  }
}
